{
  "name": "navar-tenant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:backend\"",
    "build": "npm --workspace frontend run build",
    "preview": "npm --workspace frontend run preview",
    "lint": "eslint .",
    "test": "npm --workspace frontend test && npm --workspace backend test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  }
}
